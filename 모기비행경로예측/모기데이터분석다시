        "def plot_speed_vs_displacement_analysis(dataset):\n",
        "    # 1. 데이터 집계를 위한 리스트 선언\n",
        "    g1_speed = []\n",
        "    g1_disp = []\n",
        "\n",
        "    g2_speed = []\n",
        "    g2_disp = []\n",
        "\n",
        "    for i in range(len(dataset)):\n",
        "        item = dataset[i]\n",
        "        v_scalar = item['raw']['v_scalar'].numpy()\n",
        "        hist_targets = item['raw']['historical_targets'].numpy()\n",
        "\n",
        "        # 💡 [그래프 1 데이터] t=0 시점의 속력과 외부 정답 라벨 변위 매핑\n",
        "        # v_scalar의 마지막 인덱스[-1]가 i=10 즉 t=0 시점의 속력입니다.\n",
        "        g1_speed.append(v_scalar[-1])\n",
        "        g1_disp.append(item['true_future_disp'])\n",
        "\n",
        "        # 💡 [그래프 2 데이터] 과거 9개 타임스텝의 내부 윈도우 이력 매핑\n",
        "        for idx in range(len(v_scalar)):\n",
        "            disp_vector = hist_targets[idx]\n",
        "\n",
        "            # 시퀀스 끝부분의 NaN 예외 처리\n",
        "            if np.isnan(disp_vector).any():\n",
        "                continue\n",
        "\n",
        "            # 국소 변위 벡터의 크기(L2 Norm) 계산\n",
        "            disp_scalar = np.linalg.norm(disp_vector)\n",
        "\n",
        "            g2_speed.append(v_scalar[idx])\n",
        "            g2_disp.append(disp_scalar)\n",
        "\n",
        "    # 2. 시각화 프레임 설정\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(18, 7))\n",
