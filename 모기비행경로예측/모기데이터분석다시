        "def test_candidate_a_pipeline(dataset):\n",
        "    dt = dataset.extractor.dt\n",
        "\n",
        "    kappa_dot_final_list = []\n",
        "    true_future_disp_list = []\n",
        "    target_local_x = []\n",
        "    target_local_y = []\n",
        "    target_local_z = []\n",
        "\n",
        "    for i in range(len(dataset)):\n",
        "        item = dataset[i]\n",
        "        kappa_tensor = item['raw']['kappa']  # torch.Tensor, shape: (num_steps - 2,)\n",
        "\n",
        "        if len(kappa_tensor) < 2:\n",
        "            continue\n",
        "\n",
        "        # 데이터셋의 마지막 두 시점의 곡률을 사용하여 \\dot{\\kappa}_0 근사\n",
        "        kappa_curr = kappa_tensor[-1].item()\n",
        "        kappa_prev = kappa_tensor[-2].item()\n",
        "\n",
        "        kappa_dot_final = (kappa_curr - kappa_prev) / dt\n",
        "        kappa_dot_final_list.append(kappa_dot_final)\n",
        "\n",
        "        # 비교 대상 타깃 메트릭 저장\n",
        "        true_future_disp_list.append(item['true_future_disp'])\n",
        "\n",
        "        # Frenet 프레임 기준 (T, N, B) 공간에서의 상대적 미래 위치\n",
        "        local_target = item['target_local'].numpy()\n",
        "        target_local_x.append(local_target[0])\n",
        "        target_local_y.append(local_target[1])\n",
        "        target_local_z.append(local_target[2])\n",
        "\n",
        "    # 벡터화 변환\n",
        "    kappa_dot = np.array(kappa_dot_final_list)\n",
        "    future_disp = np.array(true_future_disp_list)\n",
        "    loc_x, loc_y, loc_z = np.array(target_local_x), np.array(target_local_y), np.array(target_local_z)\n",
        "\n",
        "    # 1. 피어슨 상관계수 산출\n",
        "    corr_disp, p_disp = pearsonr(kappa_dot, future_disp)\n",
        "    corr_z, p_z = pearsonr(kappa_dot, loc_z)  # B축(종법선) 방향 변위와의 상관성 확인\n",
