        "        axes[0].plot(time_labels, mean_neg, label='Future $D_N < 0$ (Turn Outside)', color='crimson', linewidth=3.5)\n",
        "        axes[0].fill_between(time_labels, mean_neg - std_neg * 0.15, mean_neg + std_neg * 0.15, color='crimson', alpha=0.15)\n",
