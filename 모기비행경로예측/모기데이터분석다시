        "\n",
        "        # 4개 시점 이상의 히스토리가 확보되지 않으면 제외\n",
        "        if len(v_scalars) < 4:\n",
        "            continue\n",
        "\n",
        "        if isinstance(a_seq, torch.Tensor):\n",
        "            a_seq = a_seq.numpy()\n",
        "\n",
        "        # 마지막 4개 시점 (t=-3, t=-2, t=-1, t=0)의 phi 계산\n",
        "        current_history = []\n",
        "        for t in [-4, -3, -2, -1]:\n",
        "            v_norm = v_scalars[t] + 1e-8\n",
        "            v_dot_a = v_dot_as[t]\n",
        "\n",
