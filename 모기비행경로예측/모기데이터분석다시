        "    sns.scatterplot(x=g1_speed, y=g1_disp, alpha=0.4, ax=axes[0], color='crimson')\n",
        "    # OLS 트렌드라인 추가를 위한 선형 회귀 피팅\n",
        "    m1, c1 = np.polyfit(g1_speed, g1_disp, 1)\n",
        "    x_range1 = np.linspace(min(g1_speed), max(g1_speed), 100)\n",
        "    axes[0].plot(x_range1, m1 * x_range1 + c1, color='darkred', linestyle='-', linewidth=2,\n",
        "                 label=f'Trendline (Slope: {m1:.4f})')\n",
        "    axes[0].set_title('Graph 1: Current Speed (t=0) vs True Future Displacement (t=80ms)', fontsize=12)\n",
        "    axes[0].set_xlabel('Scalar Speed ||v(0)||')\n",
        "    axes[0].set_ylabel('True Label Displacement ||y_true - p(0)||')\n",
        "    axes[0].legend()\n",
        "    axes[0].grid(True, linestyle=':')\n",
        "\n",
        "    # [우측 플롯] 그래프 2: 과거 9개 구간 속력 vs 구간별 80ms 이력 변위\n",
        "    sns.scatterplot(x=g2_speed, y=g2_disp, alpha=0.2, ax=axes[1], color='royalblue')\n",
        "    # OLS 트렌드라인 추가를 위한 선형 회귀 피팅\n",
        "    m2, c2 = np.polyfit(g2_speed, g2_disp, 1)\n",
        "    x_range2 = np.linspace(min(g2_speed), max(g2_speed), 100)\n",
        "    axes[1].plot(x_range2, m2 * x_range2 + c2, color='darkblue', linestyle='-', linewidth=2,\n",
        "                 label=f'Trendline (Slope: {m2:.4f})')\n",
        "    axes[1].set_title('Graph 2: Historical Speeds vs 80ms Window Displacements', fontsize=12)\n",
        "    axes[1].set_xlabel('Instantaneous Speed ||v(t)||')\n",
