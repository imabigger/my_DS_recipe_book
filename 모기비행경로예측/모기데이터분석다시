        "\n",
        "            cos_phi = v_dot_a / (v_norm * a_norm)\n",
        "            cos_phi = np.clip(cos_phi, -1.0, 1.0)\n",
        "            phi = np.arccos(cos_phi)\n",
        "            current_history.append(np.degrees(phi)) # 직관을 위해 도(degree) 단위 변환\n",
        "\n",
        "        phi_histories.append(current_history)\n",
        "        d_n_list.append(local_target[1]) # 미래 D_N\n",
