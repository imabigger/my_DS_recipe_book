        "class MosquitoGeometryFeatureExtractor:\n",
        "    def __init__(self, dt=0.04, eps=1e-8):\n",
        "        self.dt = dt\n",
        "        self.eps = eps\n",
        "\n",
        "    def __call__(self, x_raw):\n",
        "        num_steps = len(x_raw)\n",
        "\n",
        "        v_scalar_list = []\n",
        "        v_dot_a_list = []\n",
        "        kappa_list = []\n",
        "        historical_seq = []\n",
        "        T_list, N_list, B_list = [], [], []\n",
        "        a_list = []\n",
        "\n",
        "        for i in range(2, num_steps):\n",
        "            p0, p_m1, p_m2 = x_raw[i], x_raw[i-1], x_raw[i-2]\n",
        "\n",
        "            v = (p0 - p_m1) / self.dt\n",
        "            a = (p0 - 2 * p_m1 + p_m2) / (self.dt ** 2)\n",
        "\n",
        "            v_norm = np.linalg.norm(v) + self.eps\n",
        "            cross_va = np.cross(v, a)\n",
        "            cross_norm = np.linalg.norm(cross_va) + self.eps\n",
        "\n",
        "            v_dot_a = np.dot(v, a)\n",
        "\n",
        "            T_vec = v / v_norm\n",
        "            if cross_norm > self.eps:\n",
        "                kappa = cross_norm / (v_norm ** 3)\n",
        "                B_vec = cross_va / cross_norm\n",
        "                N_vec = np.cross(B_vec, T_vec)\n",
        "            else:\n",
        "                kappa = 0.0\n",
        "                B_vec = np.zeros(3)\n",
        "                N_vec = np.zeros(3)\n",
        "\n",
        "            R_curr = np.column_stack([T_vec, N_vec, B_vec])\n",
        "\n",
        "            if i + 2 < num_steps:\n",
        "                delta_local = np.dot(R_curr.T, x_raw[i+2] - x_raw[i])\n",
        "            else:\n",
        "                delta_local = np.array([np.nan, np.nan, np.nan])\n",
        "\n",
        "            a_list.append(a)\n",
        "            v_scalar_list.append(v_norm - self.eps)\n",
        "            v_dot_a_list.append(v_dot_a)\n",
        "            kappa_list.append(np.clip(kappa, 0.0, 1000.0))\n",
        "            historical_seq.append(delta_local)\n",
        "\n",
        "            T_list.append(T_vec)\n",
        "            N_list.append(N_vec)\n",
        "            B_list.append(B_vec)\n",
        "\n",
        "        # 💡 [코드 최적화] 리스트 참조 없이 마지막 루프의 R_curr를 그대로 얕은 복사\n",
        "        R_current = R_curr\n",
        "\n",
        "        return {\n",
        "            'v_scalar': np.array(v_scalar_list),\n",
        "            'kappa': torch.tensor(np.array(kappa_list), dtype=torch.float32),\n",
        "            'v_dot_a': np.array(v_dot_a_list),\n",
        "            'historical_targets': torch.tensor(np.array(historical_seq), dtype=torch.float32),\n",
        "            'R_current': R_current,\n",
        "            'a' : np.array(a_list)\n",
        "        }\n",
        "\n",
        "class MosquitoFrenetDataset(Dataset):\n",
        "    def __init__(self, data_dir, label_path):\n",
        "        self.file_paths = sorted(glob.glob(os.path.join(data_dir, \"*.csv\")))\n",
        "        self.labels_df = pd.read_csv(label_path)\n",
        "\n",
        "        if 'id' in self.labels_df.columns:\n",
        "            self.labels_df.set_index('id', inplace=True)\n",
        "\n",
        "        self.extractor = MosquitoGeometryFeatureExtractor()\n",
        "        self.precomputed_data = []\n",
        "\n",
        "        outlier_threshold = 1.4\n",
        "\n",
        "        print(\"단일 패스 고속 필터링 및 데이터셋 구축 중...\")\n",
        "        for file_path in tqdm(self.file_paths):\n",
        "            df = pd.read_csv(file_path)\n",
        "            x_raw = df[['x', 'y', 'z']].values[:11, :]\n",
        "\n",
        "            # 1. 일단 피처를 추출\n",
        "            raw_features = self.extractor(x_raw)\n",
        "            v_scalars = raw_features['v_scalar']\n",
        "\n",
        "            # 2. 💡 [On-the-fly 필터링] 속력이 1.4m/s 이상인 시점이 하나라도 있으면 append 하지 않고 즉시 pass!\n",
        "            # 이거 나중에 바꿔야함 ( 지금 과거에 하나라도 있으면 필터링 됨. 이게 정당하지는 않잔ㅎ아.)\n",
        "            if np.any(v_scalars >= outlier_threshold):\n",
        "                continue\n",
        "\n",
        "            # 3. 정상 데이터만 이하 후속 전산 작업 진행\n",
        "            file_name = os.path.basename(file_path).split('.')[0]\n",
        "            raw_features['v_scalar'] = torch.tensor(v_scalars, dtype=torch.float32)\n",
        "\n",
        "            y_abs = self.labels_df.loc[file_name, ['x', 'y', 'z']].values.astype(np.float32)\n",
        "            p0_final = x_raw[-1]\n",
        "            true_future_disp = np.linalg.norm(y_abs - p0_final)\n",
        "\n",
        "            # t=0 시점 정답 투영 연산 복구 성립\n",
        "            R_current_np = raw_features['R_current']\n",
        "            delta_global = y_abs - p0_final\n",
        "            target_local = np.dot(R_current_np.T, delta_global)\n",
        "\n",
        "            data_item = {\n",
        "                'raw': raw_features,\n",
        "                'true_future_disp': true_future_disp,\n",
        "                'target_local': torch.tensor(target_local, dtype=torch.float32)\n",
        "            }\n",
        "            self.precomputed_data.append(data_item)\n",
        "\n",
        "        print(f\"구축 완료: 최종 {len(self.precomputed_data)}개 시퀀스 확보 (이상치 전량 제거 완료)\")\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.precomputed_data)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        return self.precomputed_data[idx]"
      ],
