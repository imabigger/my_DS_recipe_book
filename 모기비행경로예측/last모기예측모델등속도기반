        "def find_optimal_ensemble(lstm_oof, gru_oof, lgb_oof, dataset):\n",
        "    target_global_list = []\n",
        "    for item in dataset:\n",
        "        target_global_list.append(item['target_global'].numpy())\n",
        "    target_global = np.array(target_global_list)\n",
        "\n",
        "    best_rhit = 0.0\n",
        "    best_weights = None\n",
        "    best_oof_preds = None\n",
        "\n",
        "    print(\"\\n🔍 Optimizing Blending Weights for Ensemble...\")\n",
        "    for w_lstm in np.linspace(0, 1, 21):\n",
        "        for w_gru in np.linspace(0, 1 - w_lstm, 21):\n",
        "            w_lgb = np.subtract(np.subtract(1.0, w_lstm), w_gru)\n",
        "\n",
        "            term_lstm = np.multiply(w_lstm, lstm_oof)\n",
        "            term_gru = np.multiply(w_gru, gru_oof)\n",
        "            term_lgb = np.multiply(w_lgb, lgb_oof)\n",
        "            blended_preds = np.add(np.add(term_lstm, term_gru), term_lgb)\n",
        "\n",
        "            errors = np.linalg.norm(np.subtract(blended_preds, target_global), axis=1)\n",
        "            rhit = np.mean(errors < 0.01)\n",
        "\n",
        "            if rhit > best_rhit:\n",
        "                best_rhit = rhit\n",
        "                best_weights = (w_lstm, w_gru, w_lgb)\n",
        "                best_oof_preds = blended_preds\n",
        "\n",
        "    print(f\"🌟 Best Ensemble Weights -> LSTM: {best_weights[0]:.2f} | GRU: {best_weights[1]:.2f} | LightGBM: {best_weights[2]:.2f}\")\n",
        "    print(f\"🌟 Ensembled Global OOF R-hit (1cm): {np.multiply(best_rhit, 100.0):.2f}%\")\n",
        "    return best_oof_preds, torch.tensor(np.linalg.norm(np.subtract(best_oof_preds, target_global), axis=1), dtype=torch.float32)\n"
