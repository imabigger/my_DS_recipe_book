        "        mean_penalty = torch.mean(soft_penalty)\n",
        "\n",
        "        term1 = torch.mul(torch.subtract(torch.tensor(1.0, device=pred_residual.device), torch.tensor(self.alpha, device=pred_residual.device)), base_l1_loss)\n",
        "        term2 = torch.mul(torch.tensor(self.alpha, device=pred_residual.device), mean_penalty)\n",
        "        total_loss = torch.add(term1, term2)\n",
        "        return total_loss"
