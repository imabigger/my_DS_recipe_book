        "def compute_global_predictions(p0, v0_norm, R_current, residual_pred, kappa_last, v_dot_a_last, dt=0.08):\n",
        "    \"\"\"\n",
        "    [물리 업그레이드]: 프레네 프레임의 실시간 회전 효과를 고려한 엄밀한 해석적 원궤도 적분을 기저선으로 채택합니다.\n",
        "    \"\"\"\n",
        "    batch_size = p0.size(0)\n",
        "    device = p0.device\n",
        "\n",
        "    dt_tensor = torch.tensor(dt, device=device)\n",
        "    # x = kappa_last * v0_norm * dt\n",
        "    x = torch.mul(torch.mul(kappa_last, v0_norm), dt_tensor)\n",
        "\n",
        "    # 접선 성분 sinc(x) 기하 연산 전이\n",
        "    sinc_val = torch.where(\n",
        "        x > 1e-4,\n",
        "        torch.div(torch.sin(x), x),\n",
        "        torch.subtract(torch.tensor(1.0, device=device), torch.div(torch.pow(x, 2), torch.tensor(6.0, device=device)))\n",
        "    )\n",
        "    y_T = torch.mul(torch.mul(v0_norm.squeeze(-1), dt_tensor), sinc_val.squeeze(-1))\n",
        "\n",
        "    # 법선 성분 코사인 인자 기하 연산 전이\n",
        "    half_x_sq = torch.mul(torch.tensor(0.5, device=device), torch.pow(x, 2))\n",
        "    cos_factor = torch.where(\n",
        "        x > 1e-4,\n",
        "        torch.div(torch.subtract(torch.tensor(1.0, device=device), torch.cos(x)), half_x_sq),\n",
        "        torch.subtract(torch.tensor(1.0, device=device), torch.div(torch.pow(x, 2), torch.tensor(12.0, device=device)))\n",
        "    )\n",
        "    y_N = torch.mul(\n",
        "        torch.mul(torch.mul(torch.tensor(0.5, device=device), v0_norm.squeeze(-1)), dt_tensor),\n",
        "        torch.mul(x.squeeze(-1), cos_factor.squeeze(-1))\n",
        "    )\n",
        "\n",
        "    baseline_local = torch.zeros(batch_size, 3, device=device)\n",
        "    baseline_local[:, 0] = y_T\n",
        "    baseline_local[:, 1] = y_N\n",
        "\n",
        "    total_local = torch.add(baseline_local, residual_pred)\n",
        "    disp_global = torch.matmul(R_current, total_local.unsqueeze(-1)).squeeze(-1)\n",
        "    pred_global = torch.add(p0, disp_global)\n",
        "    return pred_global\n",
