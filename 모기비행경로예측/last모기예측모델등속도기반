        "    def forward(self, rnn_outputs):\n",
        "        attn_scores = self.attn_weights(rnn_outputs)\n",
        "        attn_weights = torch.softmax(attn_scores, dim=1)\n",
        "        context_vector = torch.sum(torch.mul(rnn_outputs, attn_weights), dim=1)\n",
        "        return context_vector\n",
