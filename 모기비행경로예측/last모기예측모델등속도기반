      "cell_type": "code",
      "source": [
        "def compute_global_predictions(p0, v0_norm, R_current, residual_pred, dt=0.08):\n",
        "    \"\"\"\n",
        "    p0: (batch, 3)\n",
        "    v0_norm: (batch, 1)\n",
        "    R_current: (batch, 3, 3)\n",
        "    residual_pred: (batch, 3) -> 모델이 예측한 프레네 잔차\n",
        "    \"\"\"\n",
        "    batch_size = p0.size(0)\n",
        "    device = p0.device\n",
        "\n",
        "    # 1. 등속도 baseline 설계: 로컬 프레네 공간 상 [v0 * dt, 0, 0] 선형 연산\n",
        "    baseline_local = torch.zeros(batch_size, 3, device=device)\n",
        "    baseline_local[:, 0] = torch.mul(v0_norm.squeeze(-1), dt)\n",
        "\n",
        "    # 2. 로컬 물리 정합 변위 결합\n",
        "    total_local = baseline_local + residual_pred\n",
        "\n",
        "    # 3. R_current 행렬 곱을 통한 3차원 글로벌 변환\n",
        "    disp_global = torch.matmul(R_current, total_local.unsqueeze(-1)).squeeze(-1)\n",
        "\n",
        "    # 4. 최종 예측 글로벌 복원\n",
        "    pred_global = p0 + disp_global\n",
        "    return pred_global\n",
        "\n",
        "\n",
        "def compute_rhit_tensor_level(pred_global, target_global):\n",
        "    \"\"\"\n",
        "    GPU 텐서 상에서 병렬 유클리드 거리를 측정하여 고속 R-hit 연산 수행\n",
        "    \"\"\"\n",
        "    error_distances = torch.linalg.norm(pred_global - target_global, dim=1)\n",
        "    hit_mask = error_distances < 0.01  # 1cm 이내\n",
        "    rhit_score = hit_mask.float().mean().item()\n",
        "    return rhit_score, error_distances\n",
        "\n",
        "class MarginSoftRHitLoss(nn.Module):\n",
        "    \"\"\"\n",
        "    MAE(L1) Loss를 하부 기저로 유지하면서,\n",
        "    1.0cm 경계 바깥에 인접한 Close-calls를 임계치 아래로 밀어넣는 미분가능한 Surrogate R-hit Penalty의 결합형 손실함수\n",
        "    \"\"\"\n",
        "    def __init__(self, alpha=0.4, k=400.0, threshold=0.01):\n",
        "        super(MarginSoftRHitLoss, self).__init__()\n",
        "        self.l1 = nn.L1Loss()\n",
        "        self.alpha = alpha\n",
        "        self.k = k\n",
        "        self.threshold = threshold\n",
        "\n",
        "    def forward(self, pred_residual, target_residual, p0, v0_norm, R_current, target_global):\n",
        "        # 1. 기본 L1 오차 학습\n",
        "        base_l1_loss = self.l1(pred_residual, target_residual)\n",
        "\n",
