        "class MosquitoGeometryFeatureExtractor:\n",
        "    def __init__(self, dt=0.04, eps=1e-8):\n",
        "        self.dt = dt\n",
        "        self.eps = eps\n",
        "\n",
        "    def __call__(self, x_window):\n",
        "        num_steps = len(x_window)\n",
        "\n",
        "        v_scalar_list = []\n",
        "        v_dot_a_list = []\n",
        "        log_kappa_list = []\n",
        "        log_ratio_list = []\n",
        "        theta_rot_list = []  # 9차원 R_diff 대신 1차원 회전각 사용\n",
        "        delta_t_vec_list = [] # 접선 방향 벡터의 미소 변이 (3차원)\n",
        "        phi_list = [] # 속도와 가속도 방향의 이루는 각도\n",
        "        #cross_va_normalized_list = [] # [추가]\n",
        "\n",
        "        R_prev = None\n",
        "        T_prev = None\n",
        "\n",
        "        for i in range(2, num_steps):\n",
        "            p0, p_m1, p_m2 = x_window[i], x_window[i-1], x_window[i-2]\n",
        "\n",
        "            v = (p0 - p_m1) / self.dt\n",
        "            a = (p0 - 2 * p_m1 + p_m2) / (self.dt ** 2)\n",
        "\n",
        "            v_norm = np.linalg.norm(v) + self.eps\n",
        "            cross_va = np.cross(v, a)\n",
        "            cross_norm = np.linalg.norm(cross_va) + self.eps\n",
        "            v_dot_a = np.dot(v, a)\n",
        "            a_norm = np.linalg.norm(a) + self.eps\n",
        "            cos_phi = np.clip(v_dot_a / (v_norm * a_norm), -1.0, 1.0)\n",
        "            phi = np.arccos(cos_phi)\n",
        "\n",
        "            T_vec = v / v_norm\n",
        "            if cross_norm > self.eps:\n",
        "                kappa = cross_norm / (np.power(v_norm, 3))\n",
        "                B_vec = cross_va / cross_norm\n",
        "                N_vec = np.cross(B_vec, T_vec)\n",
        "            else:\n",
        "                kappa = 0.0\n",
        "                B_vec = np.zeros(3)\n",
        "                N_vec = np.zeros(3)\n",
        "\n",
        "            R_curr = np.column_stack([T_vec, N_vec, B_vec])\n",
        "\n",
        "            # SO(3) 상의 회전 변이 각도 계산\n",
        "            if R_prev is not None:\n",
        "                R_rel = np.matmul(R_prev.T, R_curr)\n",
        "                trace_val = np.trace(R_rel)\n",
        "                cos_theta = np.clip((trace_val - 1.0) / 2.0, -1.0, 1.0)\n",
        "                theta_rot = np.arccos(cos_theta)\n",
        "                delta_T = T_vec - T_prev\n",
        "            else:\n",
        "                theta_rot = 0.0\n",
        "                delta_T = np.zeros(3)\n",
        "\n",
        "            R_prev = R_curr.copy()\n",
        "            T_prev = T_vec.copy()\n",
        "\n",
        "            log_kappa = np.log(kappa + self.eps)\n",
        "\n",
        "            if v_dot_a > 0:\n",
        "                v_cubed = np.power(v_norm - self.eps, 3)\n",
        "                numerator = np.multiply(kappa, v_cubed)\n",
        "                ratio = np.divide(numerator, v_dot_a + self.eps)\n",
        "                log_ratio = np.log(ratio + self.eps)\n",
        "            else:\n",
        "                log_ratio = np.log(self.eps)\n",
        "\n",
        "            a_N = cross_norm / v_norm\n",
        "            denom = np.multiply(v_norm, a_norm) + self.eps\n",
        "            cross_va_normalized = cross_va / denom\n",
        "\n",
        "            v_scalar_list.append(v_norm - self.eps)\n",
        "            v_dot_a_list.append(v_dot_a)\n",
        "            log_kappa_list.append(log_kappa)\n",
        "            log_ratio_list.append(log_ratio)\n",
        "            theta_rot_list.append(theta_rot)\n",
        "            delta_t_vec_list.append(delta_T)\n",
        "            phi_list.append(phi)\n",
        "            #cross_va_normalized_list.append(cross_va_normalized) # [추가] 리스트에 저장\n",
        "\n",
        "\n",
        "        feature_matrix = np.column_stack([\n",
        "            v_scalar_list,\n",
        "            v_dot_a_list,\n",
        "            log_kappa_list,\n",
        "            log_ratio_list,\n",
        "            theta_rot_list,\n",
        "            phi_list,\n",
        "            #cross_va_normalized_list, # [추가] 피처 행렬 결합\n",
        "            np.array(delta_t_vec_list)\n",
        "        ])\n",
        "\n",
        "        return {\n",
        "            'features': torch.tensor(feature_matrix, dtype=torch.float32),\n",
        "            'v_scalar': np.array(v_scalar_list),\n",
        "            'R_current': R_curr\n",
        "        }\n",
        "\n",
